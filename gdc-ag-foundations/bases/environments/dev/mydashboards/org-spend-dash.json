          "rawQuery": true,
          "rawSql": "WITH data AS (\n  SELECT\n    start_date AS \"time\",\n    SUM(invoice_line_items.total) AS total\n  FROM\n    public.invoices LEFT JOIN public.invoice_line_items ON invoices.invoice_id = invoice_line_items.invoice_id\n  WHERE description IN ($description) AND invoices.billing_account_id IN ($internal_billing_account_id)\n  GROUP BY start_date\n  ORDER BY start_date\n)\n\nSELECT time, total FROM (\n  SELECT time, SUM(total) OVER (ORDER BY time ASC ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS total\n  FROM data\n) AS main\nWHERE $__timeFilter(time)",
