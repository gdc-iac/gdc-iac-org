# helmfile.yaml for 001-AO-VM-CREATE
# Logic engine to dynamically generate Helm releases based on tenants.yaml

# Load tenants.yaml directly
{{- $vals := (readFile "tenants.yaml" | fromYaml) }}

# Define a version suffix from environment (e.g. VERSION=-v2)
{{- $version := env "VERSION" | default "" }}

# Define Organization Name from environment (e.g. ORG_NAME=community)
{{- $orgName := env "ORG_NAME" | default "org-1" }}

# Define administrative logical project namespace (e.g. IAC_PROJECT=iac-staging)
{{- $iacProjectNamespace := env "IAC_PROJECT" | default "iac-root" }}

# Define Zone and Host Suffix parameters
{{- $zoneName := env "ZONE_NAME" | default "east1" }}
{{- $hostSuffix := env "HOST_SUFFIX" | default "google.gdch.test" }}
{{- $domainSuffixContext := replace "." "-" $hostSuffix }}

# Admin cluster context (for hooks)
{{- $adminContext := env "ADMIN_CLUSTER_CONTEXT" | default (printf "%s-admin-%s-gdch_console-%s-%s-%s_%s-admin" $orgName $zoneName $orgName $zoneName $domainSuffixContext $orgName) }}

# Global API context
{{- $globalContext := env "GLOBAL_API_CONTEXT" | default (printf "global-api-gdch_console-%s-%s-%s_global-api" $orgName $zoneName $domainSuffixContext) }}

helmDefaults:
  createNamespace: false
  wait: true

releases:
  # LOOP 1: Iterate over Tenants
  {{- range $tenantName, $tenantConfig := $vals.gdc_tenants }}
    
    # LOOP 2: Iterate over Projects
    {{- range $project := $tenantConfig.global.projects }}
    {{- $projectName := printf "%s%s" $project.name $version }}

    # --- STAGE 1: DEPLOY GDC PROJECT ---
    - name: {{ $projectName }}
      chart: {{ $vals.gdc_projects_chart_path }}
      kubeContext: {{ $globalContext }}
      namespace: {{ $iacProjectNamespace }}
      installed: true
      labels:
        tier: project
        tenant: {{ $tenantName }}
      values:
        - projects:
            {{ $tenantName }}:
              name: {{ $projectName }}
              namespace: platform

    # --- STAGE 1a: DEPLOY GDC PROJECT IAM ROLESBINDINGS ---
    - name: {{ $projectName }}-iam-rolebindings
      chart: {{ $vals.gdc_iam_rolebindings_chart_path }}
      kubeContext: {{ $globalContext }}
      namespace: {{ $iacProjectNamespace }}
      installed: true
      labels:
        tier: project-iam-rolebindings
        tenant: {{ $tenantName }}
      needs:
        - {{ $globalContext }}/{{ $iacProjectNamespace }}/{{ $projectName }}
      values:
        - iamrolebindings: {{ $project.iamrolebindings | toJson }}
          namespace: {{ $projectName }}

    # --- STAGE 1b: DEPLOY PROJECT CLUSTER BINDINGS ---
    {{- if $project.cluster_bindings }}
    - name: {{ $projectName }}-cluster-bindings
      chart: "../../../charts/gdc-project-bindings"
      kubeContext: {{ $adminContext }}
      namespace: {{ $iacProjectNamespace }}
      installed: true
      labels:
        tier: project-bindings
        tenant: {{ $tenantName }}
      needs:
        - {{ $globalContext }}/{{ $iacProjectNamespace }}/{{ $projectName }}
      values:
        - namespace: platform
          projectBindings:
            {{- range $cb := $project.cluster_bindings }}
            - clusterName: {{ env "USER_CLUSTER_NAME" | default $cb.clusterName }}
              projectName: {{ $projectName }}
            {{- end }}
    {{- end }}

    # --- STAGE 2: VMS ---
    {{- if and $project.resources (hasKey $project.resources "vms") }}
    {{- range $vm := $project.resources.vms }}
    - name: {{ $vm.name }}
      chart: {{ $vals.gdc_vm_chart_path }}
      kubeContext: {{ $adminContext }}
      namespace: {{ $iacProjectNamespace }}
      installed: true
      labels:
        tier: vm
        tenant: {{ $tenantName }}
        project: {{ $projectName }}
      needs:
        - {{ $globalContext }}/{{ $iacProjectNamespace }}/{{ $projectName }}
        - {{ $globalContext }}/{{ $iacProjectNamespace }}/{{ $projectName }}-iam-rolebindings
        - {{ $adminContext }}/{{ $iacProjectNamespace }}/{{ $projectName }}-cluster-bindings
      hooks:
        - events: ["presync"]
          showlogs: true
          command: "sh"
          args: 
            - "-c"
            - |
              echo "Waiting for GDC namespace creation and IAM role propagation..."
              START_TIME=$(date +%s)
              TIMEOUT=3600
              until kubectl --context {{ $adminContext }} auth can-i get virtualmachines -n {{ $projectName }} >/dev/null 2>&1; do
                if [ $(( $(date +%s) - START_TIME )) -ge "$TIMEOUT" ]; then
                  echo "❌ Timeout: Namespace and role propagation failed to sync within 1 hour."
                  exit 1
                fi
                echo "...still waiting for namespace and role propagation to sync..."
                sleep 10
              done
              echo "Environment is ready!"
      values:
        - virtualMachines:
            - name: {{ $vm.name }}
              namespace: {{ $projectName }}
              imageName: {{ $vm.image_name }}
              imageNamespace: {{ $vm.image_namespace }}
              bootDiskSize: {{ $vm.boot_disk_size }}
              machineType: {{ $vm.machine_type }}
              ssh: {{ $vm.ssh | toJson }}
    {{- end }}
    {{- end }}

    {{- end }} # End Project Loop
  {{- end }} # End Tenant Loop
