iac:
  # IaC can be invoked by user or service account
- role: "project-iam-admin"
  subject_kind: "User"
  subject_name: &iac_sa "{{ config.IAC_SA_FQN }}"
- role: "project-bucket-admin"
  subject_kind: "User"
  subject_name: *iac_sa
- role: "project-networkpolicy-admin"
  subject_kind: "User"
  subject_name: *iac_sa
- role: "harbor-instance-admin"
  subject_kind: "User"
  subject_name: *iac_sa
- role: "harbor-project-creator"
  subject_kind: "User"
  subject_name: *iac_sa
- role: "standard-cluster-admin"
  subject_kind: "User"
  subject_name: *iac_sa
- role: "workbench-notebooks-admin"
  subject_kind: "User"
  subject_name: *iac_sa
global:
  shared_infra_project_name: &shared_infra_project_name "data-ets-15357-infra"
  shared_harbor_admin_name: &shared_harbor_admin_name "{{ config.AIS_PREFIX }}{{ config.HARBOR_ADMIN_EMAIL }}"
  cluster_backup_sa: &cluster_backup_sa "cbk-sa"
  harbor_backup_sa: &harbor_backup_sa "hbk-sa"
  cluster_backup_bucket_name: &cluster_backup_bucket_name "cluster-backup"
  harbor_backup_bucket_name: &harbor_backup_bucket_name "harbor-backup"
  # FQN can be obtained from the bucket object metadata after creation
  # this is a rationale for splitting the deployment into two steps
  # to obtain FQDNs use:
  # kubectl get buckets -n data-ets-backup
  cluster_backup_bucket_fqdn: &cluster_backup_bucket_fqdn "<TODO>-cluster-backup"
  harbor_backup_bucket_fqdn: &harbor_backup_bucket_fqdn "<TODO>-harbor-backup"
  backup_bucket_endpoint: &backup_bucket_endpoint "https://objectstorage.${ORG_NAME}.${GDCH_ZONE}.${GDCH_DOMAIN}"
  # follow https://docs.cloud.google.com/distributed-cloud/hosted/docs/latest/gdch/platform/pa-user/grant-obtain-storage-access#obtain_service_account_access
  # to obtain the secret name:
  # kubectl get secrets --namespace $PROJECT_NAME -o json | jq -r --arg USER_NAME "${SA_NAME:?}" '.items[] | select( (.metadata.annotations."object.gdc.goog/subject"==$USER_NAME)) | .metadata.name'
  cluster_backup_secret_name: &cluster_backup_secret_name "<TODO>"
  harbor_backup_secret_name: &harbor_backup_secret_name "<TODO>"
  backup_location: &backup_location "{{ config.GDCH_ZONE }}"
  cluster_backup_repo_name: &cluster_backup_repo_name "{{ config.CLUSTER_NAME }}-cluster-backup"
  harbor_backup_repo_name: &harbor_backup_repo_name "harbor-backup"
  projects:
    - name: *shared_infra_project_name
      project-service-accounts:
      - name: *harbor_backup_sa
      - name: *cluster_backup_sa
      iam-role-bindings:
      - role: "project-grafana-viewer"
        subject_kind: "User"
        subject_name: *shared_harbor_admin_name
      - role: "project-iam-admin"
        subject_kind: "User"
        subject_name: *shared_harbor_admin_name
      - role: "project-bucket-admin"
        subject_kind: "User"
        subject_name: *shared_harbor_admin_name
      - role: "project-bucket-object-admin"
        subject_kind: "User"
        subject_name: *shared_harbor_admin_name
      - role: "workload-viewer"
        subject_kind: "User"
        subject_name: *shared_harbor_admin_name
      - role: "backup-creator"
        subject_kind: "User"
        subject_name: *shared_harbor_admin_name
      - role: "harbor-instance-admin"
        subject_kind: "User"
        subject_name: *shared_harbor_admin_name
      - role: "harbor-project-creator"
        subject_kind: "User"
        subject_name: *shared_harbor_admin_name
      project-network-policies:
{% for project in all_projects %}
      - subject:
          subject_type: ManagedService
          managed_services:
            match_types:
            - 'mhs'
        ingress:
        - from:
          - project_selector:
              projects:
                match_names:
                - "{{ project }}"
{% endfor %}
{{ config.GDCH_ZONE }}:
  clusters:
  - name: "{{ config.CLUSTER_NAME }}"
    clusterNetwork:
      podCIDRSize: "{{ config.CLUSTER_POD_CIDR_SIZE }}"
      serviceCIDRSize: "{{ config.CLUSTER_SERVICE_CIDR_SIZE }}"
    initialVersion:
      kubernetesVersion: "{{ config.CLUSTER_K8S_VERSION }}"
    loadBalancer:
      ingressServiceIPSize: "{{ config.CLUSTER_INGRESS_SERVICE_IP_SIZE }}"
    nodePools:
    - name: "{{ config.CLUSTER_NODE_POOL_NAME }}"
      machineTypeName: "{{ config.CLUSTER_MACHINE_TYPE }}"
      nodeCount: "{{ config.CLUSTER_NODE_COUNT }}"
    releaseChannel: "UNSPECIFIED"
    projectBindings:
    - "{{ config.IAC_PROJECT }}"
{% for project in all_projects %}
    - "{{ project }}"
{% endfor %}
  projects:
  - name: *shared_infra_project_name
    buckets:
    - name: *cluster_backup_bucket_name
    - name: *harbor_backup_bucket_name
    rbac-role-bindings:
    - role: "project-bucket-object-admin"
      subject_kind: "ServiceAccount"
      subject_name: *harbor_backup_sa
    - role: "project-bucket-object-admin"
      subject_kind: "ServiceAccount"
      subject_name: *cluster_backup_sa
    harbors:
    - name: &harbor_instance "data-ets-mhs-574"
      projects:
      - name: "data-ets-574"
        autoscan: false
        creatorkind: "User"
        creatorname: *shared_harbor_admin_name
{% if config.BACKUP_BUCKETS_READY == "yes" %}
    backup-repositories:
      harbor:
      - name: *harbor_backup_repo_name
        secretReference:
          name: *harbor_backup_secret_name
        endpoint: *backup_bucket_endpoint
        region: *backup_location
        bucket: *harbor_backup_bucket_fqdn
        description: "Daily harbor backup repository"
      cluster:
      - name: *cluster_backup_repo_name
        secretReference:
          name: *cluster_backup_secret_name
        endpoint: *backup_bucket_endpoint
        type: "S3"
        s3Options:
          bucket: *cluster_backup_bucket_fqdn
          region: *backup_location
          forcePathStyle: true
        importPolicy: "ReadWrite"
{% endif %}
{% if config.BACKUP_REPOS_READY == "yes" %}
    backup-plans:
      harbor:
      - name: "harbor-backup-plan"
        harborInstance: *harbor_instance
        cronSchedule: "0 3 * * *"
        backupRepository: *harbor_backup_repo_name
      cluster:
      - name: "{{ config.CLUSTER_NAME }}-cluster-backup-plan"
        targetCluster:
          targetClusterType: "UserCluster"
          targetClusterName:
            kind: "Cluster"
            name: "{{ config.CLUSTER_NAME }}"
        cronSchedule: "0 2 * * *"
        clusterBackupRepositoryName: *cluster_backup_repo_name
{% endif %}
