{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "registry": {
          "type": "string"
        },
        "imagePullSecrets": {
          "type": "array"
        },
        "commonLabels": {
          "type": "object"
        },
        "commonAnnotations": {
          "type": "object"
        }
      }
    },
    "namespace": {
      "type": "string"
    },
    "registry": {
      "type": "string"
    },
    "gdc": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "failover": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "apps": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "phase": {
      "type": "integer"
    },
    "auth": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string"
        },
        "allowSimulatedOidc": {
          "type": ["string", "boolean"]
        },
        "headerUserKey": {
          "type": "string"
        },
        "oidcAuthority": {
          "type": "string"
        },
        "oidcClientId": {
          "type": "string"
        },
        "oidcRedirectUri": {
          "type": "string"
        }
      }
    },
    "ai": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "storage": {
      "type": "object"
    }
  }
}
