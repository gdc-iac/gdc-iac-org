{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "registry": {
          "type": "string"
        },
        "imagePullSecrets": {
          "type": "array"
        },
        "commonLabels": {
          "type": "object"
        },
        "commonAnnotations": {
          "type": "object"
        }
      }
    },
    "gdc": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "db": {
          "type": "object",
          "properties": {
            "base64EncodedPassword": {
              "type": "string"
            }
          }
        },
        "failover": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "apps": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "keycloak": {
      "type": "object",
      "properties": {
        "db": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            },
            "username": {
              "type": "string"
            },
            "password": {
              "type": "string"
            },
            "existingSecret": {
              "type": "string"
            },
            "urlKey": {
              "type": "string"
            },
            "usernameKey": {
              "type": "string"
            },
            "passwordKey": {
              "type": "string"
            }
          }
        },
        "extraVolumes": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "extraVolumeMounts": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    }
  }
}
