{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "registry": {
          "type": "string"
        },
        "imagePullSecrets": {
          "type": "array"
        },
        "commonLabels": {
          "type": "object"
        },
        "commonAnnotations": {
          "type": "object"
        }
      }
    },
    "gdc": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "failover": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "apps": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "activeFramework": {
          "type": "string"
        },
        "ollamaModelVariant": {
          "type": "string"
        },
        "modelRoutingConfig": {
          "type": "string"
        },
        "redisUrl": {
          "type": "string"
        },
        "tier1ModelTag": {
          "type": "string"
        },
        "tier2ModelTag": {
          "type": "string"
        },
        "enforceParameterOverrides": {
          "type": "boolean"
        },
        "envoyInferencePool": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "serviceUrl": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
