bases:
  - ../../bases/environments.yaml.gotmpl
  - ../../bases/helmDefaults.yaml.gotmpl
---
{{- $vals := .Values }}
{{- $envData := .Values | get .Environment.Name dict }}

templates:
  sa-template:
    kubeContext: {{ $vals | get "gdc_context_global" "global-api-context" }}
    namespace: {{ $vals | get "gdc_release_namespace" "iac-root" }}
    createNamespace: false
    installed: true
    wait: {{ env "HELM_WAIT" | default (.Values | get "helm_wait" false | toString) | eq "true" }}

releases:
  {{- range $tenantName, $tenantConfig := $envData.gdc_tenants }}

    {{- range $project := $tenantConfig.global.projects }}
      {{- if and $project.serviceaccounts (gt (len $project.serviceaccounts) 0) }}
      - name: {{ $project.name }}-service-accounts
        chart: {{ $vals | get "gdc_projects_sa_chart_path" "../../../charts/gdc-project-service-accounts" }}
        {{- if ($vals | get "gdc_projects_sa_chart_version" "") }}
        version: {{ $vals | get "gdc_projects_sa_chart_version" | quote }}
        {{- end }}
        labels:
          stage: 1-project-factory
          tenant: {{ $tenantName | quote }}
          project: {{ $project.name | quote }}
          type: "service-accounts"
        inherit:
          - template: sa-template
        values:
          - name: {{ $project.name }}
            projectserviceaccounts: {{ $project.serviceaccounts | toJson }}
      {{- end }}
    {{- end }}
  {{- end }}
