bases:
  - ../../bases/environments.yaml.gotmpl
  - ../../bases/helmDefaults.yaml.gotmpl
---
{{- $vals := .Values }}
{{- $envData := .Values | get .Environment.Name dict }}

# --- PRE-FLIGHT SECURITY VALIDATION: Enforce strict context isolation per tenant ---
{{- range $tenantName, $tenantConfig := $envData.gdc_tenants }}
  {{- $tenantGlobalContext := $tenantConfig.global.kube_context_global | default ($vals | get "gdc_context_global" "") }}
  {{- if not $tenantGlobalContext }}
    {{- fail (printf "\n\n❌ SECURITY BREACH PREVENTED: Tenant '%s' does not have an explicitly defined 'kube_context_global' context!\n" $tenantName) }}
  {{- end }}
{{- end }}

templates:
  netpol-template:
    namespace: {{ $vals | get "gdc_release_namespace" "iac-root" }}
    createNamespace: false
    installed: {{ $vals | get "install_project_network_policies" true }}

releases:
  {{- range $tenantName, $tenantConfig := $envData.gdc_tenants }}
    {{- $tenantGlobalContext := $tenantConfig.global.kube_context_global | default ($vals | get "gdc_context_global") }}

    {{- range $project := $tenantConfig.global.projects }}
      {{- if and $project.resources (hasKey $project.resources "project_network_policies") }}
      - name: {{ $project.name }}-netpols
        chart: {{ $vals | get "gdc_project_network_policies_chart_path" "../../charts/gdc-project-network-policies" }}
        kubeContext: {{ $tenantGlobalContext | quote }}
        labels:
          stage: 1-project-factory
          tenant: {{ $tenantName | quote }}
          project: {{ $project.name | quote }}
          type: "project-network-policies"
        inherit:
          - template: netpol-template
        values:
          - namespace: {{ $project.name }}
            projectnetworkpolicies: {{ $project.resources.project_network_policies | toJson }}
      {{- end }}
    {{- end }}
  {{- end }}

