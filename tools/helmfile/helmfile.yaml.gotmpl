# Author: andybubune@google.com
# Load tenants.yaml directly
{{- $vals := (readFile "tenants.yaml" | fromYaml) }}

helmDefaults:
  createNamespace: false
  wait: true

releases:
  # LOOP 1: Iterate over Tenants
  {{- range $tenantName, $tenantConfig := $vals.gdc_tenants }}
    
    # LOOP 2: Iterate over Projects
    {{- range $project := $tenantConfig.global.projects }}

    # --- STAGE 1: DEPLOY GDC PROJECT ---
    - name: {{ $project.name }}
      chart: {{ $vals.gdc_projects_chart_path }}
      kubeContext: global-api-gdch_console-org-1-zone1-google-gdch-test_global-api
      namespace: iac-root
      installed: true
      labels:
        tier: project
        tenant: {{ $tenantName }}
      values:
        - projects:
            {{ $tenantName }}:
              name: {{ $project.name }}
              namespace: platform
    # --- STAGE 1a: DEPLOY GDC PROJECT IAM ROLESBINDINGS ---
    - name: {{ $project.name }}-iam-rolebindings
      chart: {{ $vals.gdc_iam_rolebindings_chart_path }}
      kubeContext: global-api-gdch_console-org-1-zone1-google-gdch-test_global-api
      namespace: iac-root
      installed: true
      labels:
        tier: project-iam-rolebindgs
        tenant: {{ $tenantName }}
      needs:
        - global-api-gdch_console-org-1-zone1-google-gdch-test_global-api/iac-root/{{ $project.name }}
      values:
        - iamrolebindings: {{ $project.iamrolebindings | toJson }}
          namespace: {{ $project.name }}

    # --- STAGE 1b: DEPLOY GDC PROJECT SA ---
    - name: {{ $project.name }}-project-sa
      chart: {{ $vals.gdc_projects_sa_chart_path }}
      kubeContext: global-api-gdch_console-org-1-zone1-google-gdch-test_global-api
      namespace: iac-root
      installed: true
      labels:
        tier: project-sa
        tenant: {{ $tenantName }}
      needs:
        # Simple name reference works because both are in iac-root
        - global-api-gdch_console-org-1-zone1-google-gdch-test_global-api/iac-root/{{ $project.name }}
        - global-api-gdch_console-org-1-zone1-google-gdch-test_global-api/iac-root/{{ $project.name }}-iam-rolebindings
      values:
        - projectserviceaccounts:
          {{- range $sa := $project.serviceaccounts }}
            - name: {{ $sa }}
              namespace: {{ $project.name }}
          {{- end }}
          name: {{ $project.name }}

    # --- STAGE 2: VMS (LOOP 3a) ---
    {{- if and $project.resources (hasKey $project.resources "vms") }}
    {{- range $vm := $project.resources.vms }}
    - name: {{ $vm.name }}
      chart: {{ $vals.gdc_vm_chart_path }}
      kubeContext: org-1-admin-zone1-gdch_console-org-1-zone1-google-gdch-test_org-1-admin
      namespace: iac-root
      installed: true
      labels:
        tier: vm
        tenant: {{ $tenantName }}
        project: {{ $project.name }}
      needs:
        - global-api-gdch_console-org-1-zone1-google-gdch-test_global-api/iac-root/{{ $project.name }}
        - global-api-gdch_console-org-1-zone1-google-gdch-test_global-api/iac-root/{{ $project.name }}-iam-rolebindings
      values:
        - virtualMachines:
            - name: {{ $vm.name }}
              # Resources deployed to: project namespace
              namespace: {{ $project.name }}
              imageName: {{ $vm.image_name }}
              imageNamespace: {{ $vm.image_namespace }}
              bootDiskSize: {{ $vm.boot_disk_size }}
              machineType: {{ $vm.machine_type }}
    {{- end }}
    {{- end }}

    # --- STAGE 3: BUCKETS (LOOP 3b) ---
    {{- if and $project.resources (hasKey $project.resources "buckets") }}
    {{- range $bucket := $project.resources.buckets }}
    - name: {{ $bucket.name }}
      chart: {{ $vals.gdc_buckets_chart_path }}
      kubeContext: org-1-admin-zone1-gdch_console-org-1-zone1-google-gdch-test_org-1-admin
      namespace: iac-root
      installed: true
      labels:
        tier: storage
        tenant: {{ $tenantName }}
        project: {{ $project.name }}
      needs:
        - global-api-gdch_console-org-1-zone1-google-gdch-test_global-api/iac-root/{{ $project.name }}
        - global-api-gdch_console-org-1-zone1-google-gdch-test_global-api/iac-root/{{ $project.name }}-iam-rolebindings
      values:
        - buckets:
            {{ $tenantName }}:
              name: {{ $bucket.name }}
              # Resources deployed to: project namespace
              namespace: {{ $project.name }}
              description: {{ $bucket.description }}
              storageClass: {{ $bucket.storage_class }}
              location: {{ $bucket.location }}
    {{- end }}
    {{- end }}

    # --- STAGE 4: DATABASES ---
    {{- if and $project.resources (hasKey $project.resources "dbs") }}
    - name: {{ $project.name }}-dbs
      chart: {{ $vals.gdc_dbs_chart_path }}
      kubeContext: org-1-admin-zone1-gdch_console-org-1-zone1-google-gdch-test_org-1-admin
      namespace: iac-root
      installed: true
      labels:
        tier: db
        tenant: {{ $tenantName }}
        project: {{ $project.name }}
      needs:
        # DBs need the Project Namespace to exist first
        - global-api-gdch_console-org-1-zone1-google-gdch-test_global-api/iac-root/{{ $project.name }}
        - global-api-gdch_console-org-1-zone1-google-gdch-test_global-api/iac-root/{{ $project.name }}-iam-rolebindings
      values:
        - {{ $project.resources.dbs | toJson }}
          # Pass the target namespace so the chart renders objects in the correct project
        - namespace: {{ $project.name }}
    {{- end }}

    {{- end }} # End Project Loop
  {{- end }} # End Tenant Loop
